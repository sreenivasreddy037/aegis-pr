# Copy to .env and fill in. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# true = deterministic offline responders (no network, no key needed)
MOCK_LLM=false
# local = in-process Qdrant; remote = Qdrant server at QDRANT_URL
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
# auto | hash | fastembed
EMBEDDING_BACKEND=auto
SANDBOX_TIMEOUT_SEC=10
CONFIDENCE_THRESHOLD=0.6
